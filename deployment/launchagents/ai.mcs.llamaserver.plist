<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>ai.mcs.llamaserver</string>
  <key>ProgramArguments</key>
  <array>
    <string>__LLAMA_BIN__</string>
    <string>-m</string><string>__MODEL__</string>
    <string>--host</string><string>127.0.0.1</string>
    <string>--port</string><string>8080</string>
    <string>-ngl</string><string>99</string>
    <string>-c</string><string>49152</string>
    <string>-np</string><string>3</string>
    <string>--spec-type</string><string>ngram-simple</string>
    <string>-fa</string><string>on</string>
    <string>-ctk</string><string>q4_0</string>
    <string>-ctv</string><string>q4_0</string>
    <string>-ub</string><string>512</string>
    <string>--cache-ram</string><string>0</string>
  </array>
  <key>KeepAlive</key><true/>
  <key>RunAtLoad</key><true/>
  <key>LimitLoadToSessionType</key>
  <array><string>Aqua</string><string>Background</string></array>
  <key>StandardOutPath</key><string>__HERMES_HOME__/logs/llamacpp.log</string>
  <key>StandardErrorPath</key><string>__HERMES_HOME__/logs/llamacpp.log</string>
  <key>WorkingDirectory</key><string>__HERMES_HOME__</string>
</dict>
</plist>
