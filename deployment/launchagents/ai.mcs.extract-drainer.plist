<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>ai.mcs.extract-drainer</string>
  <key>ProgramArguments</key>
  <array>
    <string>__PYTHON__</string>
    <string>__REPO__/mcs/extract/v4/extract_llm.py</string>
    <string>--all</string>
    <string>--workers</string><string>1</string>
    <string>--shard</string><string>0/2</string>
    <string>--slot</string><string>0</string>
    <string>--active-hours</string><string>20-07</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>30</integer>
  <key>StandardOutPath</key><string>__DATA__/extract_drain.log</string>
  <key>StandardErrorPath</key><string>__DATA__/extract_drain.log</string>
</dict>
</plist>
