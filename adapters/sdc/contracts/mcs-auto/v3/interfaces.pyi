"""Normative interface proposal, not production implementation.

DTOs must be generated/hand-typed from named schema definitions. Opaque Verified*
values are issued only by the verifier/factory; constructors are not public
APIs. No function here grants authority from a boolean or a JSON dict.
"""
from collections.abc import Mapping, Sequence
from pathlib import Path
from typing import NewType, Protocol, TypeAlias

JsonScalar: TypeAlias = str | int | bool | None
Json: TypeAlias = JsonScalar | list['Json'] | dict[str, 'Json']
Dto: TypeAlias = Mapping[str, Json]
MonoDeadline = NewType('MonoDeadline', float)
class ContractError(ValueError): code: str
class HoldError(RuntimeError): code: str
class PersistenceUnknown(BaseException): operation_id: str
class VerifiedAcceptance: ...
class VerifiedPublication: ...
class VerifiedOffer: ...
class VerifiedCompatibility: ...
class VerifiedGrant: ...
class VerifiedRuntimeProof: ...
class StagedCandidate: ...
class PreparedOperation: ...
class LiveEffectCapability: ...
class AppliedOperation: ...
class QuarantinedRuntime: ...
class OwnedLocks: ...
class TestClock(Protocol):
    def wall_ms(self) -> int: ...
    def monotonic(self) -> float: ...
    def boot_witness(self) -> str: ...
class ReadOnlyGitHub(Protocol):
    def get_json(self, path: str, *, deadline: MonoDeadline) -> Dto: ...
    def pages(self, path: str, *, maximum_pages: int, deadline: MonoDeadline) -> Sequence[Dto]: ...
class PublishGitHub(ReadOnlyGitHub, Protocol):
    def create_draft(self, request: Dto, *, deadline: MonoDeadline) -> Dto: ...
    def upload_exact_asset(self, publication: VerifiedPublication, name: str, source: Path,
                           *, deadline: MonoDeadline) -> Dto: ...
    def publish_exact_draft(self, publication: VerifiedPublication,
                            *, deadline: MonoDeadline) -> Dto: ...
class ControlTransport(Protocol):
    def post_exact(self, path: str, body: bytes, *, deadline: MonoDeadline) -> bytes: ...
class ArtifactTransport(Protocol):
    def receive_private(self, request: Dto, *, expected_size: int,
                        expected_sha256: str, destination_fd: int,
                        deadline: MonoDeadline) -> None: ...
class OwnerStore(Protocol):
    def read_verified(self) -> Dto: ...
    def publish_cas(self, expected_revision: int, next_state: Dto) -> None: ...
class RuntimeController(Protocol):
    def expected_services(self, private_config: Dto, profile: Dto) -> Sequence[Dto]: ...
    def request_drain(self, operation: PreparedOperation, *, deadline: MonoDeadline) -> None: ...
    def observe_retired(self, operation: PreparedOperation, *, deadline: MonoDeadline) -> Sequence[Dto]: ...
    def launch_quarantined(self, operation: AppliedOperation, *, deadline: MonoDeadline) -> QuarantinedRuntime: ...
    def observe_runtime(self, runtime: QuarantinedRuntime, *, deadline: MonoDeadline) -> Dto: ...

# Proposed adapters/sdc/release_auto_contract.py (pure, no network/file/process).
def parse_typed(raw: bytes, definition: str, *, max_bytes: int) -> Dto: ...
def canonical_typed(value: Dto, definition: str) -> bytes: ...
def hash_v3(kind: str, value: Json) -> str: ...
def validate_acceptance(value: Dto, *, expected_source: Dto, policy: Dto) -> None: ...
def validate_start_binding(request: Dto, grant: Dto, *, expected_scope: Dto,
                           now_ms: int, consent: Dto) -> None: ...
def validate_outcome(value: Dto, *, spent: Dto, previous: Dto | None) -> None: ...
def validate_owner_state(value: Dto, *, previous: Dto | None) -> None: ...

# Proposed scripts/development/release_publish.py, trusted publisher closure.
def resolve_build_request(event: Dto, policy: Dto, github_read: ReadOnlyGitHub,
                           *, acceptance: VerifiedAcceptance, deadline: MonoDeadline) -> Dto: ...
def verify_release_acceptance(raw: bytes, *, expected_source: Dto, policy: Dto,
                               github_read: ReadOnlyGitHub, deadline: MonoDeadline) -> VerifiedAcceptance: ...
def package_exact_source(request: Dto, *, isolated_repo: Path, output_dir: Path,
                          policy: Dto, deadline: MonoDeadline) -> Dto: ...
def reconcile_publication(plan_raw: bytes, *, registry: ControlTransport,
                           github_write: PublishGitHub, deadline: MonoDeadline) -> Dto: ...

# Existing sdc_support_signatures primitive, explicit new purpose wrappers.
def verify_v3_envelope(raw: bytes, *, purpose: str, pins: Sequence[Dto],
                        expected: Dto, now_ms: int, historical: bool = False) -> Dto: ...

# Proposed release_auto_state.py: only O-locked private state operations.
def reserve_preparation(store: OwnerStore, *, expected_revision: int,
                         candidate: StagedCandidate, consent: Dto, clock: TestClock) -> PreparedOperation: ...
def adopt_prepared_witness(store: OwnerStore, operation: PreparedOperation, *,
                           locks: OwnedLocks, witness: Dto, deadline: MonoDeadline) -> PreparedOperation: ...
def cancel_prestart(store: OwnerStore, operation: PreparedOperation, *, locks: OwnedLocks,
                     clock: TestClock) -> bytes: ...
def consume_start(store: OwnerStore, operation: PreparedOperation, grant: VerifiedGrant, *,
                   locks: OwnedLocks, clock: TestClock, deadline: MonoDeadline) -> LiveEffectCapability: ...
def complete_verified(store: OwnerStore, operation: AppliedOperation,
                        proof: VerifiedRuntimeProof, *, clock: TestClock) -> bytes: ...
def mark_unknown(store: OwnerStore, operation_id: str, *, code: str, clock: TestClock) -> None: ...
def adopt_ack(store: OwnerStore, ack_raw: bytes, *, expected_report_id: str,
               pins: Sequence[Dto], now_ms: int) -> None: ...

# Proposed release_auto_owner.py, orchestrator of the same mcs.updater owner.
def stage_candidate(offer: VerifiedOffer, compatibility: VerifiedCompatibility, *,
                      transport: ArtifactTransport, store: OwnerStore,
                      private_paths: Dto, deadline: MonoDeadline) -> StagedCandidate: ...
def prepare_runtime(candidate: StagedCandidate, *, store: OwnerStore,
                      runtime: RuntimeController, clock: TestClock,
                      deadline: MonoDeadline) -> PreparedOperation: ...
def request_start(operation: PreparedOperation, *, transport: ControlTransport,
                    store: OwnerStore, clock: TestClock,
                    deadline: MonoDeadline) -> VerifiedGrant: ...

# Existing update_apply.py: new private v3 dispatcher; v1 API preserved.
def apply_code_only_v3(capability: LiveEffectCapability, *, deadline: MonoDeadline) -> AppliedOperation: ...

# New runtime proof helper, before app imports and outside mutable control tree.
def verify_runtime_proof(raw: bytes, *, expected: Dto, native_observer: RuntimeController,
                          clock: TestClock) -> VerifiedRuntimeProof: ...
def observe_completed_operation(store: OwnerStore, operation_id: str, *,
                                 runtime: RuntimeController, clock: TestClock,
                                 deadline: MonoDeadline) -> VerifiedRuntimeProof | None: ...

# Dedicated rollout health, not the existing R1 heartbeat DTO.
def validate_rollout_binding(value: Dto, *, expected: Dto, historical: bool = False) -> None: ...
def make_health_observation(proof: VerifiedRuntimeProof, *, grant: VerifiedGrant,
                            prior_sequence: int, clock: TestClock) -> bytes: ...
def adopt_health_ack(raw: bytes, *, sent: bytes, pins: Sequence[Dto], now_ms: int) -> None: ...
def confirm_standing_policy(preview_raw: bytes, *, store: OwnerStore,
                            transport: ControlTransport, clock: TestClock) -> Dto: ...
