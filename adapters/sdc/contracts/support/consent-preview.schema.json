{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "R4 support consent preview",
  "description": "Closed typed consent preview; raw UTF-8 <=8192 bytes, ASCII CJSON, safe integers and no duplicate JSON keys. Free display names, PII, URLs and secret keys are not accepted. This schema does not establish authorization.",
  "$comment": "Runtime must require diagnostic_ids and operator_refs in strictly ascending ASCII order; issued_at <= not_before < expires_at; expires_at - issued_at <= 300000; expires_at <= consent_expires_at <= issued_at + 1800000. Runtime recomputes consent_binding_hash as SHA-256 of CJSON after excluding preview_id, issued_at, not_before, expires_at and consent_binding_hash. JSON Schema alone does not enforce these ordering, cross-field time, byte-length or hash constraints.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "preview_id",
    "product",
    "audience",
    "tenant",
    "installation",
    "device_id",
    "environment",
    "case_id",
    "claim_id",
    "key_id",
    "purpose_code",
    "capability_revision",
    "diagnostic_ids",
    "operator_refs",
    "approved_by",
    "consent_revision",
    "realm_epoch",
    "policy_epoch",
    "device_epoch",
    "case_epoch",
    "local_consent_epoch",
    "issued_at",
    "not_before",
    "expires_at",
    "consent_expires_at",
    "consent_binding_hash"
  ],
  "properties": {
    "schema_version": {
      "const": "sdc.support.consent-preview.v1"
    },
    "preview_id": {
      "$ref": "operation.schema.json#/properties/operation_id"
    },
    "product": {
      "$ref": "operation.schema.json#/properties/product"
    },
    "audience": {
      "$ref": "operation.schema.json#/properties/audience"
    },
    "tenant": {
      "$ref": "operation.schema.json#/properties/tenant"
    },
    "installation": {
      "$ref": "operation.schema.json#/properties/installation"
    },
    "device_id": {
      "$ref": "operation.schema.json#/properties/device_id"
    },
    "environment": {
      "$ref": "operation.schema.json#/properties/environment"
    },
    "case_id": {
      "$ref": "operation.schema.json#/properties/case_id"
    },
    "claim_id": {
      "$ref": "operation.schema.json#/properties/operation_id"
    },
    "key_id": {
      "$ref": "operation.schema.json#/properties/operation_id"
    },
    "purpose_code": {
      "$ref": "operation.schema.json#/properties/purpose_code"
    },
    "capability_revision": {
      "$ref": "operation.schema.json#/properties/capability_revision"
    },
    "diagnostic_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "$ref": "operation.schema.json#/properties/params/properties/diagnostic_id"
      }
    },
    "operator_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "$ref": "operation.schema.json#/properties/requested_by"
      }
    },
    "approved_by": {
      "$ref": "operation.schema.json#/properties/approved_by"
    },
    "consent_revision": {
      "$ref": "operation.schema.json#/properties/consent_revision"
    },
    "realm_epoch": {
      "$ref": "operation.schema.json#/properties/realm_epoch"
    },
    "policy_epoch": {
      "$ref": "operation.schema.json#/properties/policy_epoch"
    },
    "device_epoch": {
      "$ref": "operation.schema.json#/properties/policy_epoch"
    },
    "case_epoch": {
      "$ref": "operation.schema.json#/properties/case_epoch"
    },
    "local_consent_epoch": {
      "$ref": "operation.schema.json#/properties/local_consent_epoch"
    },
    "issued_at": {
      "$ref": "operation.schema.json#/properties/issued_at"
    },
    "not_before": {
      "$ref": "operation.schema.json#/properties/not_before"
    },
    "expires_at": {
      "$ref": "operation.schema.json#/properties/expires_at"
    },
    "consent_expires_at": {
      "$ref": "operation.schema.json#/properties/expires_at"
    },
    "consent_binding_hash": {
      "$ref": "operation.schema.json#/properties/payload_hash"
    }
  }
}
