{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "SDC release apply (R5b) closed records",
 "description": "Closed shapes for fleet/releases/apply-wire.js. Shape only: hashes, bindings, freshness and current authority are checked by the validators and the central CAS.",
 "x-max-signed-payload-bytes": 8192,
 "x-max-control-raw-bytes": 16384,
 "x-json-max-depth": 8,
 "$defs": {
  "Hex64": {
   "type": "string",
   "pattern": "^[0-9a-f]{64}$"
  },
  "UUID": {
   "type": "string",
   "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
  },
  "Owner32": {
   "type": "string",
   "pattern": "^[0-9a-f]{32}$"
  },
  "Slug": {
   "type": "string",
   "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
  },
  "Token": {
   "type": "string",
   "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$"
  },
  "Environment": {
   "type": "string",
   "pattern": "^[a-z0-9_-]{1,32}$"
  },
  "Realm": {
   "type": "string",
   "pattern": "^[A-Za-z0-9][A-Za-z0-9:_-]{0,127}$"
  },
  "Audience": {
   "type": "string",
   "pattern": "^[A-Za-z0-9:_-]{1,100}$"
  },
  "Positive": {
   "type": "integer",
   "minimum": 1,
   "maximum": 9007199254740991
  },
  "Time": {
   "type": "integer",
   "minimum": 0,
   "maximum": 9007199254740991
  },
  "Window": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "starts_at",
    "ends_at"
   ],
   "properties": {
    "starts_at": {
     "$ref": "#/$defs/Time"
    },
    "ends_at": {
     "$ref": "#/$defs/Time"
    }
   }
  },
  "Envelope": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "alg",
    "kid",
    "purpose",
    "payload",
    "signature"
   ],
   "properties": {
    "alg": {
     "const": "PS256"
    },
    "kid": {
     "type": "string",
     "pattern": "^[A-Za-z0-9_-]{1,64}$"
    },
    "purpose": {
     "enum": [
      "release-apply-consent-preview",
      "release-apply-operation",
      "release-apply-execution-grant"
     ]
    },
    "payload": {
     "type": "string",
     "pattern": "^[A-Za-z0-9_-]+$",
     "maxLength": 10923
    },
    "signature": {
     "type": "string",
     "pattern": "^[A-Za-z0-9_-]{512}$"
    }
   }
  },
