#!/bin/sh
# Bootstrap: sh scripts/mcs install [install.sh options].
set -eu
REPO="$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd -P)"
case "${1:-}" in
    install) shift; exec /bin/sh "$REPO/install.sh" "$@" ;;
    ""|-h|--help)
        printf '%s\n' 'Usage: mcs install|update|setup|doctor [options]' \
            'Before installation: sh scripts/mcs install [options]'
        exit 0 ;;
    update|setup|doctor) ;;
    *) printf '%s\n' 'Unknown command; use install, update, setup or doctor.' >&2; exit 2 ;;
esac
unset PYTHONPATH PYTHONHOME
for PY in "${MCS_ROOT:-$HOME/.mcs}/venv/bin/python3" \
          "$HOME/.hermes/hermes-agent/venv/bin/python"; do
    if [ -x "$PY" ]; then
        exec "$PY" "$REPO/mcs/ops/mcs_cli.py" "$@"
    fi
done
printf '%s\n' 'Installed interpreter missing. Run: sh scripts/mcs install' >&2
exit 1
